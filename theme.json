{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"duotone": [],
			"palette": [
				{ "slug": "marino", "name": "Azul marino", "color": "#0A2E5C" },
				{ "slug": "azul", "name": "Azul", "color": "#1559B5" },
				{ "slug": "azul-claro", "name": "Azul claro", "color": "#1E74D6" },
				{ "slug": "celeste", "name": "Celeste", "color": "#4FB8EA" },
				{ "slug": "celeste-claro", "name": "Celeste claro", "color": "#8FD3F4" },
				{ "slug": "hielo", "name": "Fondo celeste", "color": "#EAF6FD" },
				{ "slug": "hielo-claro", "name": "Fondo celeste suave", "color": "#F5FBFF" },
				{ "slug": "tinta", "name": "Texto", "color": "#13243B" },
				{ "slug": "gris", "name": "Texto secundario", "color": "#5A6B82" },
				{ "slug": "linea", "name": "Líneas", "color": "#D7E6F3" },
				{ "slug": "blanco", "name": "Blanco", "color": "#FFFFFF" }
			],
			"gradients": [
				{ "slug": "imagen-fondo", "name": "Degradado sobre imagen", "gradient": "linear-gradient(105deg, rgba(10,46,92,0.94) 0%, rgba(17,71,143,0.86) 45%, rgba(30,116,214,0.55) 100%)" },
				{ "slug": "llamado", "name": "Degradado llamado a la acción", "gradient": "linear-gradient(120deg, #1559B5 0%, #1E74D6 55%, #4FB8EA 130%)" }
			]
		},
		"typography": {
			"customFontSize": false,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": false,
			"textTransform": false,
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "Manrope, system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{ "fontFamily": "Manrope", "fontWeight": "200 800", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope-latin-wght-normal.woff2" ] },
						{ "fontFamily": "Manrope", "fontWeight": "200 800", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/manrope-latin-ext-wght-normal.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "pequeno", "name": "Pequeño", "size": "0.875rem", "fluid": false },
				{ "slug": "normal", "name": "Normal", "size": "1rem", "fluid": false },
				{ "slug": "mediano", "name": "Mediano", "size": "1.125rem", "fluid": false },
				{ "slug": "grande", "name": "Grande", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "titulo", "name": "Título de sección", "size": "2.5rem", "fluid": { "min": "1.85rem", "max": "2.5rem" } },
				{ "slug": "portada", "name": "Título de portada", "size": "3.6rem", "fluid": { "min": "2.3rem", "max": "3.6rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "1.5rem" },
				{ "slug": "40", "name": "L", "size": "clamp(1.75rem, 3vw, 2.5rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XXL", "size": "clamp(2.5rem, 5vw, 3.75rem)" }
			]
		},
		"layout": { "contentSize": "780px", "wideSize": "1180px" },
		"shadow": { "defaultPresets": false, "presets": [] },
		"border": { "radius": true, "color": true, "width": true, "style": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--blanco)", "text": "var(--wp--preset--color--tinta)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--manrope)", "fontSize": "var(--wp--preset--font-size--normal)", "lineHeight": "1.6" },
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "24px", "right": "24px" }
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--marino)" },
				"typography": { "fontWeight": "800", "lineHeight": "1.15", "letterSpacing": "-0.02em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--portada)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--titulo)" } },
			"h3": { "typography": { "fontSize": "1.15rem", "letterSpacing": "-0.01em" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--azul)" },
				":hover": { "color": { "text": "var(--wp--preset--color--marino)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--azul)", "text": "var(--wp--preset--color--blanco)" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "26px", "right": "26px" } },
				"typography": { "fontWeight": "700", "fontSize": "0.95rem" },
				"shadow": "none",
				":hover": { "color": { "background": "var(--wp--preset--color--marino)", "text": "var(--wp--preset--color--blanco)" } }
			}
		},
		"blocks": {
			"core/paragraph": { "color": { "text": "inherit" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Cabecera", "area": "header" },
		{ "name": "footer", "title": "Pie de página", "area": "footer" }
	],
	"customTemplates": []
}
